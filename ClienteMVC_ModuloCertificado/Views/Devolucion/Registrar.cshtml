@{
    ViewBag.Title = "Registrar Devolución de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 30px;">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title" style="font-weight: bold;">
                        <i class="glyphicon glyphicon-retweet"></i> Registrar Devolución de Venta (Conexión Segura WCF HTTPS)
                    </h3>
                </div>
                <div class="panel-body">
                    <p class="text-muted">
                        Complete los datos de la devolución. Al confirmarse la operación a través del servicio WCF con seguridad HTTPS y autenticación básica, se emitirá automáticamente el <strong>Certificado Oficial de Devolución</strong>.
                    </p>

                    <form action="@Url.Action("Certificado", "Devolucion")" method="get">
                        <div class="form-group">
                            <label for="idVenta">ID de la Venta:</label>
                            <input type="number" class="form-control" id="idVenta" name="idVenta" value="1" required />
                            <small class="text-muted">ID de la venta registrada en SQL Server.</small>
                        </div>

                        <div class="form-group">
                            <label for="idDevolucion">ID de Devolución Simulado / Correlativo:</label>
                            <input type="number" class="form-control" id="idDevolucion" name="idDevolucion" value="101" required />
                        </div>

                        <div class="form-group">
                            <label for="tipo">Tipo de Devolución:</label>
                            <select class="form-control" id="tipo" name="tipo">
                                <option value="PARCIAL">PARCIAL</option>
                                <option value="COMPLETA">COMPLETA</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="motivo">Motivo de la Devolución:</label>
                            <textarea class="form-control" id="motivo" name="motivo" rows="3" required placeholder="Ej: Producto en mal estado de empaque o cambio por garantía...">Producto presentado por el cliente para cambio por garantía de frescura.</textarea>
                        </div>

                        <div class="form-group">
                            <label for="total">Monto Total a Devolver (S/):</label>
                            <input type="number" step="0.01" class="form-control" id="total" name="total" value="45.00" required />
                        </div>

                        <div class="alert alert-info" style="font-size: 0.9rem;">
                            <strong><i class="glyphicon glyphicon-lock"></i> Canal Seguro:</strong>
                            Esta operación invoca el servicio WCF protegido mediante certificado SSL autofirmado (HTTPS localhost:44350) y credenciales autorizadas.
                        </div>

                        <button type="submit" class="btn btn-success btn-lg btn-block">
                            <i class="glyphicon glyphicon-certificate"></i> Registrar y Emitir Certificado
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
